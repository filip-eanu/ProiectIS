<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ro.magazin.client.controller.LoginController"
      spacing="10" prefWidth="340">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Autentificare" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Email"/>
    <TextField fx:id="txtEmail" promptText="exemplu@email.com"/>

    <Label text="Parola"/>
    <PasswordField fx:id="txtParola" onAction="#onAutentificare"/>

    <Button text="Autentificare" defaultButton="true" maxWidth="Infinity" onAction="#onAutentificare"/>
    <Hyperlink text="Nu aveti cont? Creati unul" onAction="#onCreareCont"/>
</VBox>
